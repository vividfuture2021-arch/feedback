.reply-box {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #eef7f4;
}

.reply-title {
  display: block;
  color: #176b5b;
  font-size: 24rpx;
  font-weight: 700;
}

.reply-content {
  display: block;
  margin-top: 8rpx;
  color: #31413d;
  font-size: 25rpx;
  line-height: 1.55;
}

.reply-empty {
  color: #7b8b87;
}
